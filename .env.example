# Copy this file to .env in the project root. Never commit the real .env file.
PORT=5000
# Paste the MongoDB Atlas connection string here. Replace <password> with the database user's URL-encoded password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/precision_irrigation?retryWrites=true&w=majority
# Set to true only when developing without MongoDB; data will then use server/storage.json.
USE_JSON_STORAGE=false
ML_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:5000/api
